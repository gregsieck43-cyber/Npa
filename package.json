{
  "name": "npn-gamma-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Persistent local agent desktop, CLI and MCP",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs --import ./scripts/test-loopback-http.mjs --test --test-concurrency=1 build/tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "package": "node scripts/package.mjs",
    "build:ide": "node scripts/build-ide.mjs",
    "brand:ide": "node scripts/brand-ide.mjs",
    "test:ide": "node scripts/test-ide.mjs",
    "ide": "node build/src/ide/start.js",
    "start": "build\\native\\resource-budget.exe launch node_modules\\electron\\dist\\electron.exe build\\desktop\\main.cjs",
    "test:frontend": "node scripts/test.mjs scripts/test-frontend.mjs",
    "cli": "node build/src/entry.js --cli",
    "mcp": "node build/src/entry.js --mcp",
    "test:smoke": "node scripts/test.mjs --import ./scripts/test-loopback-http.mjs --test --test-concurrency=1 build/tests/app-pause-mock.test.js build/tests/entrypoint-cli-mcp-acceptance.test.js build/tests/interfaces-history.test.js build/tests/desktop-provider-import.test.js build/tests/desktop-provider-connection.test.js"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/vscode": "1.100.0",
    "codemirror": "6.0.2",
    "electron": "44.6.0",
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "rcedit": "5.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "fflate": "0.8.2",
    "pptxgenjs": "4.0.1"
  }
}
