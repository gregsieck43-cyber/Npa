{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": ".",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "ide/extension/src/**/*.ts",
    "ide/extension/ui/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/frontend",
    "node_modules",
    "build",
    "release"
  ]
}
